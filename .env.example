# --- Linq (Person A) ---
LINQ_API_KEY=
LINQ_FROM_NUMBER=
PUBLIC_APP_URL=            # public https base, no trailing slash. cloudflared/ngrok/vercel URL.

# --- Agent (Person B) ---
GROQ_API_KEY=
# Comma-separated: Groq's free token cap is 100k/DAY PER MODEL, so we rotate.
GROQ_MODEL=openai/gpt-oss-120b,moonshotai/kimi-k2-instruct,llama-3.3-70b-versatile
ANTHROPIC_API_KEY=         # optional fallback, only if someone funds credit
LLM_PROVIDER=groq
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=900

TRANSPORT_MODE=auto        # auto | hafas | mock  (mock = canned routes kill switch)
TRANSPORT_TIMEOUT_MS=9000
REMINDER_MINUTES=25
HISTORY_TURNS=8
DSB_DEEPLINK_MODE=prefill  # prefill | plain

# --- Supabase (Person D) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Stripe (Person C — Railway) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Frontend (Person C — Vercel / web/.env.local) ---
# NEXT_PUBLIC_LINQ_URL=
# NEXT_PUBLIC_IMESSAGE_HREF=
# BACKEND_URL=               # Railway origin for map + checkout proxy
# MOCK_TRIPS=                # set to 1 for local map demo without backend
